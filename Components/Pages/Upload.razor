@page "/upload"
@rendermode InteractiveServer
@inject IWebHostEnvironment Environment

<PageTitle>Upload Image</PageTitle>

<div class="container mt-4">
    <h1>Upload an Image</h1>
    
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }
    
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }
    
    <div class="mb-3">
        <label for="fileInput" class="form-label">Select Image</label>
        <InputFile id="fileInput" OnChange="@HandleFileSelected" accept="image/*" class="form-control" />
    </div>
    
    @if (isUploading)
    {
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Uploading...</span>
        </div>
    }
</div>

@code {
    private string successMessage = "";
    private string errorMessage = "";
    private bool isUploading = false;
    private const long MaxFileSize = 5 * 1024 * 1024; // 5MB
    private readonly string[] allowedExtensions = { ".jpg", ".jpeg", ".png", ".gif", ".webp" };

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        isUploading = true;
        successMessage = "";
        errorMessage = "";

        try
        {
            var file = e.File;

            // Validate file extension
            var fileExtension = Path.GetExtension(file.Name).ToLower();
            if (!allowedExtensions.Contains(fileExtension))
            {
                errorMessage = $"Invalid file type. Allowed types: {string.Join(", ", allowedExtensions)}";
                isUploading = false;
                return;
            }

            // Validate file size
            if (file.Size > MaxFileSize)
            {
                errorMessage = $"File size exceeds the maximum allowed size of 5MB.";
                isUploading = false;
                return;
            }

            // Create unique filename to avoid conflicts
            var fileName = $"{Guid.NewGuid()}{fileExtension}";
            var uploadPath = Path.Combine(Environment.WebRootPath, "image", fileName);

            // Ensure directory exists
            Directory.CreateDirectory(Path.Combine(Environment.WebRootPath, "image"));

            // Save file
            using (var stream = file.OpenReadStream(MaxFileSize))
            {
                using (var fileStream = new FileStream(uploadPath, FileMode.Create))
                {
                    await stream.CopyToAsync(fileStream);
                }
            }

            successMessage = $"Image '{file.Name}' uploaded successfully!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error uploading file: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }
}
